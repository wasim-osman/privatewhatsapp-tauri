{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrivateWhatsapp",
  "version": "0.1.0",
  "identifier": "io.private.whatsapp",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "remote-events",
          "description": "Minimal event rights for the WhatsApp remote page (no commands)",
          "windows": ["main"],
          "remote": {
            "urls": ["https://web.whatsapp.com/**"]
          },
          "permissions": ["core:event:allow-emit", "core:webview:allow-set-webview-zoom"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}